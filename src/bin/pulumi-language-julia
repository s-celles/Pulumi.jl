#!/usr/bin/env julia
#
# pulumi-language-julia - Pulumi Language Runtime for Julia
#
# This is the entry point that the Pulumi CLI spawns when executing Julia
# programs. It starts a gRPC server implementing the LanguageRuntime service
# and prints the assigned port to stdout for the CLI to connect.
#
# Usage:
#   pulumi-language-julia
#
# The CLI will:
#   1. Spawn this process
#   2. Read the port number from stdout
#   3. Connect via gRPC and call Handshake, Run, etc.
#
# The process serves until it receives SIGINT or SIGTERM, then shuts the
# server down cleanly. See `Pulumi.run_language_host`.

# Ensure we're using the local Pulumi package if in development
if isfile(joinpath(@__DIR__, "..", "..", "Project.toml"))
    push!(LOAD_PATH, joinpath(@__DIR__, "..", ".."))
end

using Pulumi

# Run main if this script is executed directly
if abspath(PROGRAM_FILE) == @__FILE__
    exit(run_language_host())
end
